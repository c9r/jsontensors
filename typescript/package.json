{
  "name": "jsontensors",
  "version": "0.1.0",
  "description": "A JSON document with its arrays as tensors in a binary buffer behind it, in place and read as views",
  "author": "Chris Sachs",
  "license": "MIT",
  "homepage": "https://github.com/c9r/jsontensors#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c9r/jsontensors.git",
    "directory": "typescript"
  },
  "keywords": ["json", "tensor", "safetensors", "typed-array", "serialization"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check ./src/",
    "format": "oxfmt ./src/",
    "test": "node --test --conditions=types --conditions=import 'src/**/*.test.ts'",
    "clean": "rimraf dist"
  },
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./dist/node.js"
    }
  },
  "files": ["dist", "src", "!src/**/*.test.ts"],
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.2"
}
